{
  "name": "danangexpatrentals",
  "private": true,
  "workspaces": [
    "website",
    "backend",
    "types",
    "admin-website",
    "partner-website"
  ],
  "scripts": {
    "dev": "cd website && npm run dev",
    "build": "npm run build --workspace=backend && npm run build --workspace=types && npm run build --workspace=website && npm run build --workspace=admin-website && npm run build --workspace=partner-website",
    "start": "npm run start --workspace=website",
    "dev:admin": "cd admin-website && npm run dev",
    "dev:partner": "cd partner-website && npm run dev",
    "make-admin": "node scripts/run/make-admin.mjs",
    "make-partner": "node scripts/run/make-partner.mjs",
    "setup-supabase": "node scripts/run/setup-supabase.mjs",
    "seed-areas": "node scripts/run/seed-areas-from-csv.mjs scripts/data/areas.csv",
    "import-facebook-posts": "node scripts/run/import-facebook-posts.mjs",
    "extract-facebook": "node scripts/run/extract-facebook-chrome.mjs"
  },
  "devDependencies": {
    "pg": "^8.13.0"
  }
}