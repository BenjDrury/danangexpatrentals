RESEND_API_KEY=
# Required in Vercel Production: canonical public site URL (Open Graph, sitemap, canonical links).
# Without this, previews may still work via VERCEL_PROJECT_PRODUCTION_URL / hard default —
# but set it explicitly so production never emits *.vercel.app hosts.
NEXT_PUBLIC_SITE_URL=https://danangexpatrentals.com
